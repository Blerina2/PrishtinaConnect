rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // PROFILES: Allows any authenticated user to create or update their profile metrics safely
    match /users/{userId} {
      allow read, write, update: if request.auth != null;
    }

    // POSTS: Fully unlocked for reading, writing, and deletion for authenticated students
    match /posts/{postId} {
      allow read, create, delete, update: if request.auth != null;
    }

    // Traditional dynamic navigation, campus channels, and clubrooms remain working perfectly
    match /chat_requests/{requestId} { allow read, write: if request.auth != null; }
    match /channels/{channelId} {
      allow read, write: if request.auth != null;
      match /messages/{messageId} {
        allow read, create, update, delete: if request.auth != null;
      }
    }
    match /clubs/{clubId} {
      allow read, write: if request.auth != null;
      match /messages/{messageId} {
        allow read, create, update, delete: if request.auth != null;
      }
    }
    match /custom_clubs/{clubId} {
      allow read, create, update, delete: if request.auth != null;
    }
    match /clubs_meta/{metaId} { allow read, write: if request.auth != null; }
    match /club_requests/{requestId} { allow read, write: if request.auth != null; }
    match /materials/{materialId} { allow read, create, update, delete: if request.auth != null; }
  }
}

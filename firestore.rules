rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Core user account files parameters
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // CRITICAL FIX: Allows your original private chat discovery systems to read/write safely
    match /chat_requests/{requestId} {
      allow read, write: if request.auth != null;
    }

    // Scoped faculty channels and direct chat rooms metadata rules
    match /channels/{channelId} {
      allow read, write: if request.auth != null;

      match /messages/{messageId} {
        allow read, create: if request.auth != null;
        allow update, delete: if request.auth != null && request.auth.uid == resource.data.uid;
      }
    }

    // Interest clubs structure and whitelist access gateways permissions
    match /clubs/{clubId} {
      allow read, write: if request.auth != null;

      match /messages/{messageId} {
        allow read, create: if request.auth != null;
        allow update, delete: if request.auth != null && request.auth.uid == resource.data.uid;
      }
    }

    // Whitelist tokens directory and incoming application matrices rules
    match /clubs_meta/{metaId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /club_requests/{requestId} {
      allow read, write: if request.auth != null;
    }

    // Shared academic materials resource directory
    match /materials/{materialId} {
      allow read, create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }
  }
}
